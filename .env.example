# ===================================================
# Database Configuration (Read-only User for Application)
# ===================================================
DB_TYPE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=ecommerce_reader
DB_PASSWORD=reader_pass123
DB_NAME=ecommerce_db
DB_CHARSET=utf8mb4

# Admin User (Used only for migrations/initial setup if needed)
DB_ADMIN_USER=root
DB_ADMIN_PASSWORD=admin123

# ===================================================
# LLM Configuration (Google Gemini & Local Ollama)
# ===================================================
# Choose LLM provider: "gemini" (Primary with dynamic Ollama fallback) or "ollama"
LLM_PROVIDER=gemini

# Google Gemini Settings (Primary Production Engine)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# Ollama Settings (Optional Local LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_SQL_MODEL=qwen2.5-coder:7b
OLLAMA_TEMPERATURE=0.0
OLLAMA_TIMEOUT_SECONDS=600
MAX_LLM_RETRIES=2

# Query Execution Safety Limits
QUERY_TIMEOUT_SECONDS=5.0
MAX_RESULT_ROWS=100
DEFAULT_ROW_LIMIT=50
MAX_REACT_STEPS=6

# Offline SQLite Fallback (Used during local dev/testing)
SQLITE_DB_PATH=data/ecommerce.db
